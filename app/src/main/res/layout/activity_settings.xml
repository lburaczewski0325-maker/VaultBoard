<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="VaultBoard" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_parent"
        android:padding="20dp"
        android:text="Enable VaultBoard in Android Settings to begin."
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/enableKeyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Enable keyboard" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/openKeyboardPicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:text="Choose VaultBoard" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/openVault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Key Vault" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/downloadApk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:text="Download / Share latest APK" />
</LinearLayout>
